{
  "name": "gathering-app",
  "version": "0.0.1",
  "description": "Gestão de Confras, Eventos e Jogos Multiplayer",
  "productName": "Gathering App",
  "author": "Gabriel Vianna <gabriel.viannasr@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "apk:debug": "quasar build -m capacitor -T android --debug",
    "apk:release": "quasar build -m capacitor -T android",
    "apk:install:debug": "adb install -r src-capacitor/android/app/build/outputs/apk/debug/app-debug.apk",
    "apk:install:release": "adb install -r src-capacitor/android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "chart.js": "^4.5.1",
    "core-js": "^3.31.1",
    "html-to-image": "^1.11.13",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^9.14.0",
    "@quasar/app-webpack": "^4.1.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "eslint-webpack-plugin": "^4.2.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
